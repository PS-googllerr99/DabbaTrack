# Server settings. Copy to .env and fill in. Never commit .env.
# The server reads real environment variables; docker compose loads this file via `env_file`.
# For a plain `python server.py`, export them in your shell or service manager instead.

# Required: provider login PIN, 4-8 digits, not 0000. Used until the provider changes it in the app.
PROVIDER_PIN=

# Your public domain, used by the Caddyfile to get an HTTPS certificate (docker compose only).
DOMAIN=tiffin.example.com

# Business time zone: meal cutoffs and "today" follow this clock.
TZ=Asia/Kolkata

# Network. Behind a reverse proxy (Caddy in docker-compose.yml), set TRUST_PROXY=1 so login rate limits
# see the real client IP. Leave it 0 if clients connect to the server directly.
HOST=0.0.0.0
PORT=8080
TRUST_PROXY=1

# Where the SQLite database lives. Keep it outside the code folder and back it up (see DEPLOY.md).
DB_PATH=/data/tiffin.db
BACKUP_DIR=/data/backups
BACKUP_KEEP=14

# Browser origins allowed to call the API. The PWA is same-origin and the native app doesn't need CORS,
# so you can lock this to your own site, e.g. https://tiffin.example.com
CORS_ALLOW_ORIGIN=*

# Optional: send meal prompts automatically N minutes before each cutoff (0 = off).
AUTO_PROMPT_LEAD_MINUTES=0

# Optional: only if "Enhanced push security" is on in your Expo account. This is a secret.
EXPO_ACCESS_TOKEN=

# DEBUG / INFO / WARNING
LOG_LEVEL=INFO

# Never 1 in production: seeds demo customers and publishes their PINs.
DEMO_MODE=0
